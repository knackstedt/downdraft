{
  "id": "acid-postfx",
  "name": "Acid PostFX",
  "version": "1.0.0",
  "engineVersion": "^0.1.0",
  "game": "andrews-sandbox",
  "format": "asset",
  "tier": "data",
  "thread": "renderer",
  "extensions": {
    "shaders": {
      "postfx": [
        {
          "id": "acid-postfx:acid",
          "name": "Acid",
          "wgsl": "./shaders/acid.wgsl",
          "layout": "cc",
          "order": "stylized",
          "uniforms": 32,
          "settings": [
            { "key": "intensity", "label": "Intensity", "type": "slider", "default": 1.0, "min": 0, "max": 3, "step": 0.05 },
            { "key": "waveScale", "label": "Wave Scale", "type": "slider", "default": 20.0, "min": 1, "max": 50, "step": 1 },
            { "key": "hueShift", "label": "Hue Shift", "type": "slider", "default": 0.3, "min": 0, "max": 1, "step": 0.01 },
            { "key": "colorBoost", "label": "Color Boost", "type": "slider", "default": 1.2, "min": 0, "max": 3, "step": 0.05 }
          ]
        }
      ]
    }
  }
}
