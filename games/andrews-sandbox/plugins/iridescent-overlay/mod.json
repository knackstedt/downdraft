{
  "id": "iridescent-overlay",
  "name": "Iridescent Overlay",
  "version": "1.0.0",
  "engineVersion": "^0.1.0",
  "game": "andrews-sandbox",
  "format": "asset",
  "tier": "data",
  "thread": "renderer",
  "extensions": {
    "shaders": {
      "postfx": [
        {
          "id": "iridescent-overlay:iridescent",
          "name": "Iridescent",
          "wgsl": "./shaders/iridescent.wgsl",
          "layout": "cc",
          "order": "stylized",
          "uniforms": 32,
          "settings": [
            { "key": "intensity", "label": "Intensity", "type": "slider", "default": 1.2, "min": 0, "max": 2, "step": 0.05 },
            { "key": "fresnelPower", "label": "Fresnel Power", "type": "slider", "default": 1.5, "min": 0.5, "max": 8, "step": 0.1 },
            { "key": "hueSpeed", "label": "Hue Speed", "type": "slider", "default": 0.5, "min": 0, "max": 2, "step": 0.01 },
            { "key": "scale", "label": "Pattern Scale", "type": "slider", "default": 3.0, "min": 0.5, "max": 10, "step": 0.1 }
          ]
        }
      ]
    }
  }
}
