{
  "id": "color-grading",
  "name": "Color Grading",
  "version": "1.0.0",
  "engineVersion": "^0.1.0",
  "game": "andrews-sandbox",
  "format": "asset",
  "tier": "data",
  "thread": "renderer",
  "extensions": {
    "shaders": {
      "postfx": [
        {
          "id": "color-grading:grade",
          "name": "Color Grade",
          "wgsl": "./shaders/grade.wgsl",
          "layout": "cc",
          "order": "stylized",
          "uniforms": 32,
          "settings": [
            { "key": "mode", "label": "Mode", "type": "select", "default": "warm",
              "options": [
                { "label": "Warm", "value": "warm" },
                { "label": "Cool", "value": "cool" },
                { "label": "Sepia", "value": "sepia" },
                { "label": "Noir", "value": "noir" },
                { "label": "Vintage", "value": "vintage" },
                { "label": "Teal-Orange", "value": "tealorange" }
              ]
            },
            { "key": "intensity", "label": "Intensity", "type": "slider", "default": 1.0, "min": 0, "max": 1, "step": 0.01 },
            { "key": "contrast", "label": "Contrast", "type": "slider", "default": 1.2, "min": 0.5, "max": 2, "step": 0.01 },
            { "key": "saturation", "label": "Saturation", "type": "slider", "default": 1.1, "min": 0, "max": 2, "step": 0.01 }
          ]
        }
      ]
    }
  }
}
