            { "key": "radius", "label": "Radius", "type": "slider", "default": 0.6, "min": 0.3, "max": 1.5, "step": 0.01 },
            { "key": "softness", "label": "Softness", "type": "slider", "default": 0.5, "min": 0.05, "max": 1, "step": 0.01 },
            { "key": "grain", "label": "Film Grain", "type": "slider", "default": 0.2, "min": 0, "max": 0.5, "step": 0.01 }
          ]
        }
      ]
    }
