{
  "name": "downdraft-engine",
  "version": "0.1.0",
  "description": "AI-Driven Game Engine on Electron + WebGPU",
  "type": "module",
  "main": "./dist/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-builder",
    "test": "echo 'run bun test <path>.spec.ts for unit tests, or bun run draft:test / draft:test-cpu for e2e' && exit 0",
    "draft:test": "draft test --renderer=gpu",
    "draft:test-cpu": "draft test --renderer=cpu",
    "test:e2e": "bun test tests/e2e/to-the-ocean-smoke.spec.ts",
    "test:e2e:headless": "DOWNDRAFT_GPU=swiftshader bun test tests/e2e/to-the-ocean-smoke.spec.ts",
    "test:e2e:local": "bun test tests/e2e/to-the-ocean-smoke.spec.ts",
    "tsc": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "tsc:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "lint": "oxlint",
    "postinstall": "node node_modules/electron/install.js",
    "wasm:build": "wasm-pack build --target web games/falling-sand/sand-native",
    "wasm:watch": "wasm-pack build --target web --dev games/falling-sand/sand-native"
  },
  "workspaces": [
    "packages/app",
    "packages/core",
    "packages/ui",
    "packages/mcp",
    "packages/shader-graph",
    "packages/cli",
    "packages/plugins/*",
    "games/to-the-ocean",
    "games/to-the-ocean/plugins/*",
    "games/falling-sand",
    "games/falling-sand/plugins/*",
    "games/falling-sand/sand-native",
    "games/mining-rpg",
    "games/mining-rpg/plugins/*",
    "examples/plugin-tester"
  ],
  "devDependencies": {
    "@downdraft/cli": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@webgpu/types": "^0.1.71",
    "autoprefixer": "^10.4.0",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "happy-dom": "^20.11.2",
    "oxlint": "^1.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "comment-json": "^5.0.0",
    "fflate": "^0.8.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xxhash-wasm": "^0.4.2",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.downdraft.engine",
    "productName": "Downdraft Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "${productName}-${version}-${arch}-portable.exe"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm", "flatpak"],
      "category": "Game",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0"]
    },
    "rpm": {
      "depends": ["gtk3", "libnotify", "nss", "libXScrnSaver", "libXtst", "xdg-utils", "at-spi2-atk", "libuuid", "libsecret"]
    },
    "flatpak": {
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "23.08",
      "finishArgs": [
        "--socket=x11",
        "--socket=wayland",
        "--share=ipc",
        "--share=network",
        "--device=dri",
        "--filesystem=home"
      ]
    }
  }
}
