{
  "name": "downdraft-engine",
  "version": "0.8.0",
  "description": "AI-Driven Game Engine — native winit + wgpu runtime (Bun, Node, or Deno host)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test --isolate --conditions=downdraft-source --path-ignore-patterns \"**/node-mobile/build/**\" packages/ examples/plugin-tester/src/*.spec.ts",
    "draft:test": "draft test --game=packaging-smoke",
    "draft:test-cpu": "draft test --game=packaging-smoke",
    "test:e2e": "bun test tests/e2e/packaging-smoke-smoke.spec.ts",
    "test:e2e:headless": "DOWNDRAFT_GPU=swiftshader bun test tests/e2e/packaging-smoke-smoke.spec.ts",
    "test:e2e:local": "bun test tests/e2e/packaging-smoke-smoke.spec.ts",
    "tsc": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p apps/devtools/tsconfig.json --noEmit",
    "tsc:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "gen:deno-import-map": "node scripts/gen-deno-import-map.mjs",
    "gen:engine-exports": "node scripts/gen-engine-exports.mjs",
    "link:games": "node scripts/link-games.mjs",
    "lint": "oxlint"
  },
  "workspaces": [
    "packages/engine",
    "packages/cli",
    "packages/platform-native",
    "examples/plugin-tester",
    "examples/packaging-smoke",
    "apps/devtools",
    "packages/devtools"
  ],
  "devDependencies": {
    "@downdraft/cli": "workspace:*",
    "@downdraft/devtools": "workspace:*",
    "@downdraft/engine": "workspace:*",
    "@downdraft/platform-native": "workspace:*",
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.71",
    "bun-types": "1.4.2",
    "oxlint": "^1.4.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "wabt": "^1.0.39",
    "wgpu-matrix": "^3.4.2",
    "xxhash-wasm": "^0.4.2"
  }
}
