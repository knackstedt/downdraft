{
  "name": "downdraft-engine",
  "version": "0.1.1",
  "description": "AI-Driven Game Engine — native winit + wgpu runtime (Bun, Node, or Deno host)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dist": "draft dist",
    "test": "echo 'run bun test <path>.spec.ts for unit tests, or bun run draft:test / draft:test-cpu for e2e' && exit 0",
    "draft:test": "draft test --game=to-the-ocean --renderer=gpu",
    "draft:test-cpu": "draft test --game=to-the-ocean --renderer=cpu",
    "test:e2e": "bun test tests/e2e/to-the-ocean-smoke.spec.ts",
    "test:e2e:headless": "DOWNDRAFT_GPU=swiftshader bun test tests/e2e/to-the-ocean-smoke.spec.ts",
    "test:e2e:local": "bun test tests/e2e/to-the-ocean-smoke.spec.ts",
    "tsc": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "tsc:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "gen:deno-import-map": "node scripts/gen-deno-import-map.mjs",
    "gen:engine-exports": "node scripts/gen-engine-exports.mjs",
    "link:games": "node scripts/link-games.mjs",
    "lint": "oxlint"
  },
  "workspaces": [
    "packages/engine",
    "packages/cli",
    "packages/platform-native",
    "examples/plugin-tester",
    "examples/packaging-smoke"
  ],
  "devDependencies": {
    "@downdraft/cli": "workspace:*",
    "@downdraft/engine": "workspace:*",
    "@downdraft/platform-native": "workspace:*",
    "@napi-rs/cli": "^2.18.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.71",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.2",
    "oxlint": "^1.4.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "wabt": "^1.0.39",
    "wgpu-matrix": "^3.4.2"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "buffer": "^6.0.3",
    "comment-json": "^5.0.0",
    "fflate": "^0.8.2",
    "koffi": "^3.2.1",
    "recast-navigation": "^0.43.1",
    "xxh3-ts": "^2.0.1",
    "xxhash-wasm": "^0.4.2",
    "zustand": "^5.0.2"
  }
}
