{
  "name": "downdraft-engine",
  "version": "0.1.0",
  "description": "AI-Driven Game Engine on Electrobun + Bun + WGPU",
  "type": "module",
  "scripts": {
    "dev": "bun run packages/cli/src/index.ts dev",
    "build": "bun run packages/cli/src/index.ts build",
    "test": "bun test",
    "tsc": "tsc --noEmit",
    "lint": "oxlint"
  },
  "workspaces": [
    "packages/core",
    "packages/ui",
    "packages/mcp",
    "packages/shader-graph",
    "packages/cli",
    "packages/plugins/*",
    "examples/ocean-game"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@webgpu/types": "^0.1.71",
    "oxlint": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
