{
  "name": "downdraft-engine",
  "version": "0.1.0",
  "description": "AI-Driven Game Engine on Electron + WebGPU",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-builder",
    "test": "echo 'tests pending migration' && exit 0",
    "tsc": "tsc --noEmit",
    "lint": "oxlint",
    "postinstall": "node node_modules/electron/install.js"
  },
  "workspaces": [
    "packages/core",
    "packages/ui",
    "packages/mcp",
    "packages/shader-graph",
    "packages/cli",
    "packages/plugins/*",
    "games/to-the-ocean"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@webgpu/types": "^0.1.71",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "oxlint": "^1.4.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "surrealdb": "^2.0.8",
    "@surrealdb/node": "^3.0.3",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.downdraft.engine",
    "productName": "Downdraft Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Game"
    }
  }
}
