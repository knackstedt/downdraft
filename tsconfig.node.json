{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": ".tsbuildinfo.node",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "bun-types",
      "@webgpu/types",
      "vite/client"
    ],
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "@shared/*": [
        "./packages/engine/app/src/shared/*"
      ]
    }
  },
  "include": [
    "packages/engine/package.json",
    "packages/engine/app/src/shared/**/*",
    "packages/engine/app/src/main/**/*",
    "packages/engine/app/src/index.ts",
    "packages/cli/src/**/*.ts",
    "packages/engine/asset-bake/src/**/*.ts",
    "packages/engine/core/src/**/*.ts",
    "packages/engine/test/src/**/*.ts",
    "packages/engine/mcp/src/**/*.ts",
    "packages/engine/shader-graph/src/**/*.ts",
    "packages/engine/modules/*/src/**/*.ts",
    "packages/engine/libraries/*/src/**/*.ts",
    "packages/platform-native/src/**/*.ts",
    "packages/platinum-devtools/src/**/*.ts",
    "packages/platinum-devtools/tests/**/*.ts",
    "tests/**/*.ts",
    "packages/platform-native/test/**/*.ts"
  ],
  "exclude": [
    "dist",
    "packages/engine/libraries/blitz-ui/src/native-module.ts",
    "tests/test-ibl.ts",
    // This stub declares a minimal `bun:test` for the platform-native
    // standalone typecheck (packages/platform-native/tsconfig.json, which
    // runs without bun-types). Including it here would shadow the real
    // bun:test declarations for tests/e2e etc.
    "packages/platform-native/test/bun-test-globals.d.ts"
  ]
}
