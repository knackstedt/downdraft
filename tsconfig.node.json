{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "out",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["packages/app/src/shared/*"],
      "@main/*": ["packages/app/src/main/*"],
      "@downdraft/core/*": ["packages/core/src/*"],
      "@downdraft/core": ["packages/core/src/index.ts"],
      "@downdraft/mcp/*": ["packages/mcp/src/*"],
      "@downdraft/mcp": ["packages/mcp/src/index.ts"]
    }
  },
  "include": [
    "packages/app/src/main/**/*",
    "packages/app/src/preload/**/*",
    "packages/app/src/shared/**/*",
    "packages/core/src/**/*.ts",
    "packages/mcp/src/**/*.ts",
    "electron.vite.config.ts"
  ],
  "exclude": ["**/*.spec.ts"]
}
