{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": ".tsbuildinfo.node",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "@webgpu/types",
      "vite/client"
    ],
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "@shared/*": [
        "./packages/app/src/shared/*"
      ],
      "@main/*": [
        "./packages/app/src/main/*"
      ],
      "@downdraft/core/*": [
        "./packages/core/src/*"
      ],
      "@downdraft/core": [
        "./packages/core/src/index.ts"
      ],
      "@downdraft/mcp/*": [
        "./packages/mcp/src/*"
      ],
      "@downdraft/mcp": [
        "./packages/mcp/src/index.ts"
      ],
      "@downdraft/ui/*": [
        "./packages/ui/src/*"
      ],
      "@downdraft/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@downdraft/shader-graph/*": [
        "./packages/shader-graph/src/*"
      ],
      "@downdraft/shader-graph": [
        "./packages/shader-graph/src/index.ts"
      ],
      "@downdraft/cli/*": [
        "./packages/cli/src/*"
      ],
      "@downdraft/plugin-water": [
        "./packages/plugins/water/src/index.ts"
      ],
      "@downdraft/plugin-water/*": [
        "./packages/plugins/water/src/*"
      ],
      "@downdraft/plugin-physics-rapier": [
        "./packages/plugins/physics-rapier/src/index.ts"
      ],
      "@downdraft/plugin-audio-kira": [
        "./packages/plugins/audio-kira/src/index.ts"
      ],
      "@downdraft/plugin-postfx": [
        "./packages/plugins/postfx/src/index.ts"
      ],
      "@downdraft/plugin-postfx/*": [
        "./packages/plugins/postfx/src/*"
      ],
      "@downdraft/plugin-lighting": [
        "./packages/plugins/lighting/src/index.ts"
      ],
      "@downdraft/plugin-lighting/*": [
        "./packages/plugins/lighting/src/*"
      ],
      "@downdraft/plugin-weatherfx": [
        "./packages/plugins/weatherfx/src/index.ts"
      ],
      "@downdraft/plugin-weatherfx/*": [
        "./packages/plugins/weatherfx/src/*"
      ],
      "@downdraft/plugin-weather": [
        "./packages/plugins/weather/src/index.ts"
      ],
      "@downdraft/plugin-weather/*": [
        "./packages/plugins/weather/src/*"
      ],
      "@downdraft/plugin-entities": [
        "./packages/plugins/entities/src/index.ts"
      ],
      "@downdraft/plugin-entities/*": [
        "./packages/plugins/entities/src/*"
      ],
      "@downdraft/plugin-models": [
        "./packages/plugins/models/src/index.ts"
      ],
      "@downdraft/plugin-models/*": [
        "./packages/plugins/models/src/*"
      ],
      "@downdraft/plugin-devtools": [
        "./packages/plugins/devtools/src/index.ts"
      ],
      "@downdraft/plugin-devtools/*": [
        "./packages/plugins/devtools/src/*"
      ],
      "@downdraft/plugin-marching-cubes": [
        "./packages/plugins/marching-cubes/src/index.ts"
      ],
      "@downdraft/plugin-marching-cubes/*": [
        "./packages/plugins/marching-cubes/src/*"
      ],
      "@downdraft/plugin-surface-nets": [
        "./packages/plugins/surface-nets/src/index.ts"
      ],
      "@downdraft/plugin-surface-nets/*": [
        "./packages/plugins/surface-nets/src/*"
      ],
      "@downdraft/plugin-persistence": [
        "./packages/plugins/persistence/src/index.ts"
      ],
      "@downdraft/plugin-persistence/*": [
        "./packages/plugins/persistence/src/*"
      ],
      "@downdraft/plugin-electron-osr": [
        "./packages/plugins/electron-osr/src/index.ts"
      ],
      "@downdraft/plugin-electron-osr/*": [
        "./packages/plugins/electron-osr/src/*"
      ],
      "@downdraft/plugin-xr": [
        "./packages/plugins/xr/src/index.ts"
      ],
      "@downdraft/plugin-xr/*": [
        "./packages/plugins/xr/src/*"
      ],
      "@downdraft/app": [
        "./packages/app/src/index.ts"
      ],
      "@downdraft/app/main": [
        "./packages/app/src/main/index.ts"
      ],
      "@downdraft/app/preload": [
        "./packages/app/src/preload/index.ts"
      ],
      "@downdraft/app/shared": [
        "./packages/app/src/shared/index.ts"
      ],
      "@downdraft/app/vite": [
        "./packages/app/src/vite/index.ts"
      ],
      "@downdraft/app/renderer": [
        "./packages/app/src/renderer/index.ts"
      ],
      "@to-the-ocean/plugin-boats": [
        "./games/to-the-ocean/plugins/boats/src/index.ts"
      ],
      "@to-the-ocean/plugin-boats/*": [
        "./games/to-the-ocean/plugins/boats/src/*"
      ],
      "@to-the-ocean/plugin-buoyancy": [
        "./games/to-the-ocean/plugins/buoyancy/src/index.ts"
      ],
      "@to-the-ocean/plugin-buoyancy/*": [
        "./games/to-the-ocean/plugins/buoyancy/src/*"
      ],
      "@to-the-ocean/plugin-collision": [
        "./games/to-the-ocean/plugins/collision/src/index.ts"
      ],
      "@to-the-ocean/plugin-collision/*": [
        "./games/to-the-ocean/plugins/collision/src/*"
      ],
      "@to-the-ocean/plugin-crafting": [
        "./games/to-the-ocean/plugins/crafting/src/index.ts"
      ],
      "@to-the-ocean/plugin-crafting/*": [
        "./games/to-the-ocean/plugins/crafting/src/*"
      ],
      "@to-the-ocean/plugin-economy": [
        "./games/to-the-ocean/plugins/economy/src/index.ts"
      ],
      "@to-the-ocean/plugin-economy/*": [
        "./games/to-the-ocean/plugins/economy/src/*"
      ],
      "@to-the-ocean/plugin-fishing": [
        "./games/to-the-ocean/plugins/fishing/src/index.ts"
      ],
      "@to-the-ocean/plugin-fishing/*": [
        "./games/to-the-ocean/plugins/fishing/src/*"
      ],
      "@to-the-ocean/plugin-inventory": [
        "./games/to-the-ocean/plugins/inventory/src/index.ts"
      ],
      "@to-the-ocean/plugin-inventory/*": [
        "./games/to-the-ocean/plugins/inventory/src/*"
      ],
      "@to-the-ocean/plugin-items": [
        "./games/to-the-ocean/plugins/items/src/index.ts"
      ],
      "@to-the-ocean/plugin-items/*": [
        "./games/to-the-ocean/plugins/items/src/*"
      ],
      "@to-the-ocean/plugin-survival": [
        "./games/to-the-ocean/plugins/survival/src/index.ts"
      ],
      "@to-the-ocean/plugin-survival/*": [
        "./games/to-the-ocean/plugins/survival/src/*"
      ],
      "@to-the-ocean/plugin-wildlife": [
        "./games/to-the-ocean/plugins/wildlife/src/index.ts"
      ],
      "@to-the-ocean/plugin-wildlife/*": [
        "./games/to-the-ocean/plugins/wildlife/src/*"
      ]
    }
  },
  "include": [
    "packages/app/src/main/**/*",
    "packages/app/src/preload/**/*",
    "packages/app/src/shared/**/*",
    "packages/app/src/renderer/**/*",
    "packages/app/src/vite/**/*",
    "packages/app/src/index.ts",
    "packages/core/src/**/*.ts",
    "packages/mcp/src/**/*.ts",
    "packages/ui/src/**/*",
    "packages/shader-graph/src/**/*.ts",
    "packages/plugins/*/src/**/*.ts",
    "games/*/plugins/*/src/**/*.ts",
    "electron.vite.config.ts",
    "games/*/electron.vite.config.ts",
    "games/*/src/main.ts",
    "games/*/src/preload.ts",
    "examples/*/electron.vite.config.ts",
    "examples/*/src/main.ts",
    "examples/*/src/preload.ts"
  ],
  "exclude": [
    "dist",
    "**/*.spec.ts"
  ]
}
