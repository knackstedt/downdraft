{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": ".tsbuildinfo.web",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "@webgpu/types"
    ],
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "xxh3-ts": [
        "./packages/engine/libraries/persistence/src/xxh3-ts.d.ts"
      ],
      "@shared/*": [
        "./games/to-the-ocean/src/shared/*",
        "./packages/engine/app/src/shared/*"
      ],
      "@sandbox/shared/*": [
        "./games/andrews-sandbox/src/shared/*"
      ],
      "@sim/*": [
        "./games/to-the-ocean/src/simulation/*"
      ],
      "@to-the-ocean/library-boats": [
        "./games/to-the-ocean/libraries/boats/src/index.ts"
      ],
      "@to-the-ocean/library-boats/*": [
        "./games/to-the-ocean/libraries/boats/src/*"
      ],
      "@to-the-ocean/module-buoyancy": [
        "./games/to-the-ocean/modules/buoyancy/src/index.ts"
      ],
      "@to-the-ocean/module-buoyancy/*": [
        "./games/to-the-ocean/modules/buoyancy/src/*"
      ],
      "@to-the-ocean/module-collision": [
        "./games/to-the-ocean/modules/collision/src/index.ts"
      ],
      "@to-the-ocean/module-collision/*": [
        "./games/to-the-ocean/modules/collision/src/*"
      ],
      "@to-the-ocean/module-crafting": [
        "./games/to-the-ocean/modules/crafting/src/index.ts"
      ],
      "@to-the-ocean/module-crafting/*": [
        "./games/to-the-ocean/modules/crafting/src/*"
      ],
      "@to-the-ocean/library-economy": [
        "./games/to-the-ocean/libraries/economy/src/index.ts"
      ],
      "@to-the-ocean/library-economy/*": [
        "./games/to-the-ocean/libraries/economy/src/*"
      ],
      "@to-the-ocean/library-fishing": [
        "./games/to-the-ocean/libraries/fishing/src/index.ts"
      ],
      "@to-the-ocean/library-fishing/*": [
        "./games/to-the-ocean/libraries/fishing/src/*"
      ],
      "@to-the-ocean/module-inventory": [
        "./games/to-the-ocean/modules/inventory/src/index.ts"
      ],
      "@to-the-ocean/module-inventory/*": [
        "./games/to-the-ocean/modules/inventory/src/*"
      ],
      "@to-the-ocean/library-items": [
        "./games/to-the-ocean/libraries/items/src/index.ts"
      ],
      "@to-the-ocean/library-items/*": [
        "./games/to-the-ocean/libraries/items/src/*"
      ],
      "@to-the-ocean/library-survival": [
        "./games/to-the-ocean/libraries/survival/src/index.ts"
      ],
      "@to-the-ocean/library-survival/*": [
        "./games/to-the-ocean/libraries/survival/src/*"
      ],
      "@to-the-ocean/module-wildlife": [
        "./games/to-the-ocean/modules/wildlife/src/index.ts"
      ],
      "@to-the-ocean/module-wildlife/*": [
        "./games/to-the-ocean/modules/wildlife/src/*"
      ],
      "@to-the-ocean/util/*": [
        "./games/to-the-ocean/src/util/*"
      ],
      "@to-the-ocean/shared/*": [
        "./games/to-the-ocean/src/shared/*"
      ],
      "@andrews-sandbox/library-props": [
        "./games/andrews-sandbox/libraries/props/src/index.ts"
      ],
      "@andrews-sandbox/library-props/*": [
        "./games/andrews-sandbox/libraries/props/src/*"
      ],
      "@andrews-sandbox/library-paint": [
        "./games/andrews-sandbox/libraries/paint/src/index.ts"
      ],
      "@andrews-sandbox/library-paint/*": [
        "./games/andrews-sandbox/libraries/paint/src/*"
      ],
      "@andrews-sandbox/library-content": [
        "./games/andrews-sandbox/libraries/content/src/index.ts"
      ],
      "@andrews-sandbox/library-content/*": [
        "./games/andrews-sandbox/libraries/content/src/*"
      ],
      "@andrews-sandbox/module-spawn": [
        "./games/andrews-sandbox/modules/spawn/src/index.ts"
      ],
      "@andrews-sandbox/module-spawn/*": [
        "./games/andrews-sandbox/modules/spawn/src/*"
      ],
      "@andrews-sandbox/module-physics-props": [
        "./games/andrews-sandbox/modules/physics-props/src/index.ts"
      ],
      "@andrews-sandbox/module-physics-props/*": [
        "./games/andrews-sandbox/modules/physics-props/src/*"
      ],
      "@andrews-sandbox/module-weapons": [
        "./games/andrews-sandbox/modules/weapons/src/index.ts"
      ],
      "@andrews-sandbox/module-weapons/*": [
        "./games/andrews-sandbox/modules/weapons/src/*"
      ],
      "@andrews-sandbox/module-paint": [
        "./games/andrews-sandbox/modules/paint/src/index.ts"
      ],
      "@andrews-sandbox/module-paint/*": [
        "./games/andrews-sandbox/modules/paint/src/*"
      ],
      "@andrews-sandbox/module-content": [
        "./games/andrews-sandbox/modules/content/src/index.ts"
      ],
      "@andrews-sandbox/module-content/*": [
        "./games/andrews-sandbox/modules/content/src/*"
      ],
      "@andrews-sandbox/module-vr": [
        "./games/andrews-sandbox/modules/vr/src/index.ts"
      ],
      "@andrews-sandbox/module-vr/*": [
        "./games/andrews-sandbox/modules/vr/src/*"
      ],
      "@mining-rpg/shared/*": [
        "./games/mining-rpg/src/shared/*"
      ],
      "@mining-rpg/simulation/*": [
        "./games/mining-rpg/src/simulation/*"
      ],
      "@mining-rpg/renderer/*": [
        "./games/mining-rpg/src/renderer/*"
      ],
      "@mining-rpg/stores/*": [
        "./games/mining-rpg/src/stores/*"
      ]
    }
  },
  "files": [
    "packages/platform-native/src/ffi/runtime-globals.d.ts"
  ],
  "include": [
    "packages/engine/app/src/shared/**/*",
    "packages/engine/app/src/renderer/**/*",
    "packages/engine/app/src/mobile/**/*",
    "packages/engine/app/src/vite/**/*",
    "packages/engine/core/src/**/*.ts",
    "packages/engine/test/src/**/*.ts",
    "packages/engine/mcp/src/**/*.ts",
    "packages/engine/asset-bake/src/**/*.ts",
    "packages/engine/ui/src/**/*",
    "packages/engine/shader-graph/src/**/*.ts",
    "packages/engine/modules/*/src/**/*.ts",
    "packages/engine/libraries/*/src/**/*.ts",
    "games/*/src/**/*",
    "games/*/plugins/*/src/**/*.ts",
    "games/*/libraries/*/src/**/*.ts",
    "games/*/modules/*/src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "**/*.spec.ts",
    "games/*/src/main.ts",
    "games/*/src/preload.ts",
    "games/*/src/native-entry.ts",
    "games/*/src/pixi/native-data-bridge.ts",
    "games/*/src/pixi/native-input-router.ts",
    "games/*/src/pixi/native-scene.tsx",
    "games/*/electron.vite.config.ts",
    "examples/*/src/main.ts",
    "examples/*/src/preload.ts",
    "examples/*/electron.vite.config.ts",
    "packages/engine/libraries/pixi-ui-native/src/**/*",
    "packages/platform-native/src/**/*"
  ]
}
