{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@webgpu/types"],
    "emitDeclarationOnly": true,
    "outDir": "out",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["games/to-the-ocean/src/shared/*", "packages/app/src/shared/*"],
      "@sim/*": ["games/to-the-ocean/src/simulation/*"],
      "@downdraft/core/*": ["packages/core/src/*"],
      "@downdraft/core": ["packages/core/src/index.ts"],
      "@downdraft/plugin-postfx": ["packages/plugins/postfx/src/index.ts"],
      "@downdraft/plugin-postfx/*": ["packages/plugins/postfx/src/*"],
      "@downdraft/plugin-lighting": ["packages/plugins/lighting/src/index.ts"],
      "@downdraft/plugin-lighting/*": ["packages/plugins/lighting/src/*"],
      "@downdraft/plugin-weatherfx": ["packages/plugins/weatherfx/src/index.ts"],
      "@downdraft/plugin-weatherfx/*": ["packages/plugins/weatherfx/src/*"],
      "@downdraft/plugin-weather": ["packages/plugins/weather/src/index.ts"],
      "@downdraft/plugin-weather/*": ["packages/plugins/weather/src/*"],
      "@downdraft/plugin-entities": ["packages/plugins/entities/src/index.ts"],
      "@downdraft/plugin-entities/*": ["packages/plugins/entities/src/*"],
      "@downdraft/plugin-models": ["packages/plugins/models/src/index.ts"],
      "@downdraft/plugin-models/*": ["packages/plugins/models/src/*"],
      "@downdraft/plugin-devtools": ["packages/plugins/devtools/src/index.ts"],
      "@downdraft/plugin-devtools/*": ["packages/plugins/devtools/src/*"],
      "@downdraft/plugin-boats": ["packages/plugins/boats/src/index.ts"],
      "@downdraft/plugin-boats/*": ["packages/plugins/boats/src/*"],
      "@downdraft/plugin-water": ["packages/plugins/water/src/index.ts"],
      "@downdraft/plugin-water/*": ["packages/plugins/water/src/*"],
      "@downdraft/plugin-buoyancy": ["packages/plugins/buoyancy/src/index.ts"],
      "@downdraft/plugin-buoyancy/*": ["packages/plugins/buoyancy/src/*"],
      "@downdraft/plugin-collision": ["packages/plugins/collision/src/index.ts"],
      "@downdraft/plugin-collision/*": ["packages/plugins/collision/src/*"],
      "@downdraft/plugin-wildlife": ["packages/plugins/wildlife/src/index.ts"],
      "@downdraft/plugin-wildlife/*": ["packages/plugins/wildlife/src/*"],
      "@downdraft/plugin-fishing": ["packages/plugins/fishing/src/index.ts"],
      "@downdraft/plugin-fishing/*": ["packages/plugins/fishing/src/*"],
      "@downdraft/plugin-survival": ["packages/plugins/survival/src/index.ts"],
      "@downdraft/plugin-survival/*": ["packages/plugins/survival/src/*"],
      "@downdraft/plugin-economy": ["packages/plugins/economy/src/index.ts"],
      "@downdraft/plugin-economy/*": ["packages/plugins/economy/src/*"],
      "@downdraft/plugin-marching-cubes": ["packages/plugins/marching-cubes/src/index.ts"],
      "@downdraft/plugin-marching-cubes/*": ["packages/plugins/marching-cubes/src/*"],
      "@downdraft/plugin-surface-nets": ["packages/plugins/surface-nets/src/index.ts"],
      "@downdraft/plugin-surface-nets/*": ["packages/plugins/surface-nets/src/*"],
      "@downdraft/plugin-persistence": ["packages/plugins/persistence/src/index.ts"],
      "@downdraft/plugin-persistence/*": ["packages/plugins/persistence/src/*"],
      "@downdraft/plugin-electron-osr": ["packages/plugins/electron-osr/src/index.ts"],
      "@downdraft/plugin-electron-osr/*": ["packages/plugins/electron-osr/src/*"],
      "@downdraft/plugin-xr": ["packages/plugins/xr/src/index.ts"],
      "@downdraft/plugin-xr/*": ["packages/plugins/xr/src/*"],
      "@downdraft/ui/*": ["packages/ui/src/*"],
      "@downdraft/ui": ["packages/ui/src/index.ts"],
      "@downdraft/shader-graph/*": ["packages/shader-graph/src/*"],
      "@downdraft/shader-graph": ["packages/shader-graph/src/index.ts"]
    }
  },
  "include": [
    "packages/app/src/shared/**/*",
    "packages/core/src/**/*.ts",
    "packages/ui/src/**/*",
    "packages/shader-graph/src/**/*.ts",
    "packages/plugins/*/src/**/*.ts",
    "games/*/src/**/*"
  ],
  "exclude": ["out", "**/*.spec.ts"]
}
