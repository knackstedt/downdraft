{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": ".tsbuildinfo.web",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "@webgpu/types"
    ],
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "xxh3-ts": [
        "./packages/engine/libraries/persistence/src/xxh3-ts.d.ts"
      ],
      "@shared/*": [
        "./packages/engine/app/src/shared/*"
      ]
    }
  },
  "files": [
    "node_modules/bun-types/test.d.ts",
    "packages/platform-native/src/ffi/runtime-globals.d.ts",
    "tests/bun-globals.d.ts"
  ],
  "include": [
    "packages/engine/package.json",
    "packages/engine/app/src/shared/**/*",
    "packages/engine/app/src/renderer/**/*",
    "packages/engine/core/src/**/*.ts",
    "packages/engine/test/src/**/*.ts",
    "packages/engine/mcp/src/**/*.ts",
    "packages/engine/asset-bake/src/**/*.ts",
    "packages/engine/ui/src/**/*",
    "packages/engine/shader-graph/src/**/*.ts",
    "packages/engine/modules/*/src/**/*.ts",
    "packages/engine/libraries/*/src/**/*.ts",
    "examples/*/src/**/*",
    "tests/spec-globals.d.ts"
  ],
  "exclude": [
    "dist",
    "packages/engine/libraries/blitz-ui/src/native-module.ts",
    "packages/platform-native/src/**/*"
  ]
}
