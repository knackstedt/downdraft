{
  "name": "@downdraft/app",
  "version": "0.1.0",
  "type": "module",
  "main": "src/main/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./main": {
      "types": "./src/main/index.ts",
      "import": "./src/main/index.ts"
    },
    "./preload": {
      "types": "./src/preload/index.ts",
      "import": "./src/preload/index.ts"
    },
    "./renderer": {
      "types": "./src/renderer/index.ts",
      "import": "./src/renderer/index.ts"
    },
    "./mobile": {
      "types": "./src/mobile/index.ts",
      "import": "./src/mobile/index.ts"
    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "import": "./src/shared/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    },
    "./vite/mobile": {
      "types": "./src/vite/mobile-vite-config.ts",
      "import": "./src/vite/mobile-vite-config.ts"
    },
    "./build": {
      "types": "./src/build/index.ts",
      "import": "./src/build/index.ts"
    },
    "./package.json": "./package.json",
    "./renderer/downdraft-base.css": "./src/renderer/downdraft-base.css"
  },
  "dependencies": {
    "@downdraft/asset-bake": "^0.1.0",
    "@downdraft/core": "^0.1.0",
    "@downdraft/library-persistence": "^0.1.0",
    "@downdraft/mcp": "^0.1.0",
    "@downdraft/module-devtools": "^0.1.0",
    "@downdraft/module-electron-osr": "^0.1.0",
    "@downdraft/module-raw-input": "^0.1.0",
    "@downdraft/ui": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "Downdraft application shell \u2014 Electron main process (createDowndraftApp), preload bridge, renderer runtime (startGame/GameModule), Vite config, and mobile shell."
}
