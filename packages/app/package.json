{
  "name": "@downdraft/app",
  "version": "0.1.0",
  "type": "module",
  "main": "src/main/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./main": "./src/main/index.ts",
    "./preload": "./src/preload/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./mobile": "./src/mobile/index.ts",
    "./shared": "./src/shared/index.ts",
    "./vite": "./src/vite/index.ts",
    "./vite/mobile": {
      "types": "./src/vite/mobile.ts",
      "import": "./src/vite/mobile.ts"
    },
    "./build": "./src/build/index.ts",
    "./package.json": "./package.json",
    "./renderer/downdraft-base.css": "./src/renderer/downdraft-base.css",
    "./*": "./src/*.ts",
    "./*.css": "./src/*.css",
    "./*.ts": "./src/*.ts"
  },
  "dependencies": {
    "@downdraft/asset-bake": "^0.1.0",
    "@downdraft/core": "^0.1.0",
    "@downdraft/library-persistence": "^0.1.0",
    "@downdraft/mcp": "^0.1.0",
    "@downdraft/module-devtools": "^0.1.0",
    "@downdraft/module-electron-osr": "^0.1.0",
    "@downdraft/module-raw-input": "^0.1.0",
    "@downdraft/ui": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "Downdraft application shell \u2014 Electron main process (createDowndraftApp), preload bridge, renderer runtime (startGame/GameModule), Vite config, and mobile shell."
}
