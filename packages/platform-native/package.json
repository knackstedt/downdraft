{
  "name": "@downdraft/platform-native",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build:native": "node ../../scripts/build-native.mjs --pkg=downdraft-platform",
    "fetch:native": "node native/fetch-native.mjs",
    "postinstall": "node native/fetch-native.mjs || echo '[platform-native] native fetch skipped (offline?) \u2014 run bun run fetch:native later'",
    "test": "bun test"
  },
  "dependencies": {
    "@downdraft/engine": "^0.1.0",
    "koffi": "^3.2.1"
  },
  "optionalDependencies": {
    "@downdraft/native-darwin-arm64": "^0.1.0",
    "@downdraft/native-darwin-x64": "^0.1.0",
    "@downdraft/native-linux-arm64": "^0.1.0",
    "@downdraft/native-linux-x64": "^0.1.0",
    "@downdraft/native-win32-x64": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./*.mjs": "./src/*.mjs",
    "./*.ts": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "native",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "Native platform bindings \u2014 the Rust libdowndraft_platform cdylib (wgpu + winit + cosmic-text + image + naga) and the native device layer for running Downdraft outside Electron."
}
