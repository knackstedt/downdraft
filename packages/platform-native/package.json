{
  "name": "@downdraft/platform-native",
  "version": "0.1.2-alpha.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/knackstedt/downdraft.git",
    "directory": "packages/platform-native"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build:native": "node ../../scripts/build-native.mjs --pkg=downdraft-platform",
    "build:dist": "node ../../scripts/build-dist.mjs --pkg=platform-native",
    "fetch:native": "node native/fetch-native.mjs",
    "postinstall": "node native/fetch-native.mjs || echo '[platform-native] native fetch skipped (offline?) — run bun run fetch:native later'",
    "prepublishOnly": "node ../../scripts/build-dist.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@downdraft/engine": "^0.1.2-alpha.1",
    "koffi": "^3.2.1"
  },
  "optionalDependencies": {
    "@downdraft/native-darwin-arm64": "^0.1.2-alpha.1",
    "@downdraft/native-darwin-x64": "^0.1.2-alpha.1",
    "@downdraft/native-linux-arm64": "^0.1.2-alpha.1",
    "@downdraft/native-linux-x64": "^0.1.2-alpha.1",
    "@downdraft/native-win32-x64": "^0.1.2-alpha.1"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "downdraft-source": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "downdraft-source": "./src/*.ts",
      "default": "./dist/src/*.js"
    },
    "./*.mjs": "./src/*.mjs",
    "./*.ts": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist",
    "native/fetch-native.mjs",
    "README.md",
    "!**/*.spec.ts",
    "!**/*.test.ts",
    "!**/test-*.ts",
    "!**/spec-fixtures/**"
  ],
  "description": "Native platform bindings — the Rust libdowndraft_platform cdylib (wgpu + winit + cosmic-text + image + naga) and the native device layer DownDraft runs on."
}
