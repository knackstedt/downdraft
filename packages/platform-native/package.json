{
  "name": "@downdraft/platform-native",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build:shim": "cd native && gcc -shared -fPIC -o libwgpu_shim.so wgpu_shim.c -I./include -L./lib -lwgpu_native -lSDL2 -Wl,-rpath,'$ORIGIN/lib'",
    "build:shims": "bash native/build-shims.sh",
    "fetch:native": "node native/fetch-native.mjs",
    "postinstall": "node native/fetch-native.mjs || echo '[platform-native] native fetch skipped (offline?) — run bun run fetch:native later'",
    "test": "bun test"
  },
  "dependencies": {
    "@downdraft/core": "workspace:*",
    "koffi": "^3.2.1"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
