{
  "name": "@downdraft/shader-graph",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ],
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "!**/*.spec.ts"
  ],
  "devDependencies": {
    "@downdraft/library-postfx": "^0.1.0",
    "@downdraft/library-weatherfx": "^0.1.0",
    "@downdraft/core": "^0.1.0"
  },
  "description": "Node-based WGSL shader authoring \u2014 material graphs compile to WebGPU shaders with struct-drift validation against host-side uniform layouts."
}
