{
  "name": "@downdraft/asset-bake",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ],
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@downdraft/core": "^0.1.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "fflate": "^0.8.2",
    "jimp": "^1.6.1",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "!**/*.spec.ts"
  ]
