{
  "name": "@downdraft/core",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./profiling": "./src/profiling/index.ts",
    "./profiling/*": "./src/profiling/*.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ],
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@downdraft/shader-graph": "^0.1.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "quickjs-emscripten": "^0.32.0",
    "wgpu-matrix": "^3.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@downdraft/library-models": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@downdraft/library-models": {
      "optional": true
    }
  }
