{
  "name": "@downdraft/core",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./profiling": "./src/profiling/index.ts",
    "./profiling/*": "./src/profiling/*.ts",
    "./package.json": "./package.json",
    "./ecs": "./src/ecs/index.ts",
    "./scene": "./src/scene/index.ts",
    "./render": "./src/render/index.ts",
    "./render/bindless": "./src/render/bindless/index.ts",
    "./render/gpu-driven": "./src/render/gpu-driven/index.ts",
    "./material": "./src/material/index.ts",
    "./assets": "./src/assets/index.ts",
    "./util": "./src/util/index.ts",
    "./physics": "./src/physics/index.ts",
    "./library": "./src/library/index.ts",
    "./animation": "./src/animation/index.ts",
    "./imui": "./src/imui/index.ts",
    "./module": "./src/module/index.ts",
    "./particles": "./src/particles/index.ts",
    "./plugin": "./src/plugin/index.ts",
    "./*": "./src/*.ts",
    "./*.md": "./src/*.md",
    "./*.wgsl": "./src/*.wgsl",
    "./*.ts": "./src/*.ts"
  },
  "dependencies": {
    "@downdraft/shader-graph": "^0.1.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "quickjs-emscripten": "^0.32.0",
    "wgpu-matrix": "^3.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "!**/*.spec.ts"
  ],
  "peerDependencies": {
    "@downdraft/library-models": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@downdraft/library-models": {
      "optional": true
    }
  },
  "description": "Downdraft engine core \u2014 ECS, WebGPU renderer, module/DI system, SharedArrayBuffer sim channels, sim worker host, plugin API, animation, particles, and imui."
}
