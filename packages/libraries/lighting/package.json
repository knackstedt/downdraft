{
  "name": "@downdraft/library-lighting",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@downdraft/core": "^0.1.0",
    "@downdraft/library-weather": "^0.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
