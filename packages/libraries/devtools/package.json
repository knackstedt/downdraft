{
  "name": "@downdraft/library-devtools",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "dependencies": {
    "@downdraft/core": "^0.1.0",
    "@downdraft/module-devtools": "^0.1.0",
    "@downdraft/platform-native": "^0.1.0"
  },
  "peerDependencies": {
    "@downdraft/library-pixi-ui-native": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@downdraft/library-pixi-ui-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "native",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "Native devtools bridge \u2014 mirrors profiling and inspection data to the native devtools process."
}
