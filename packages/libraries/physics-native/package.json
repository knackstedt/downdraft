{
  "name": "@downdraft/library-physics-native",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ],
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@downdraft/core": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "native",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "Native physics backend \u2014 binds the engine's UniversalPhysicsAPI to the native physics library."
}
