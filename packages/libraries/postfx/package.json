{
  "name": "@downdraft/library-postfx",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@downdraft/core": "^0.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ],
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "Post-processing stack \u2014 21 chainable WebGPU effects (TAA, SSAO, SSR, DOF, motion blur, bloom, tonemap, and stylized passes)."
}
