{
  "name": "@downdraft/library-pixi-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ],
    "./react": "./src/react.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@downdraft/core": "^0.1.0",
    "pixi.js": "8.18.0"
  },
  "peerDependencies": {
    "@pixi/react": "^8.0.5",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@pixi/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pixi/react": "8.0.5",
    "@types/react": "^19.2.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "!**/*.spec.ts"
