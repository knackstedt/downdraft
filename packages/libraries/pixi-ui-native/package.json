{
  "name": "@downdraft/library-pixi-ui-native",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "dependencies": {
    "@downdraft/core": "^0.1.0",
    "@downdraft/platform-native": "^0.1.0",
    "pixi.js": "8.18.0"
  },
  "peerDependencies": {
    "@pixi/react": "^8.0.5",
