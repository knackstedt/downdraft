{
  "name": "@downdraft/mcp",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@downdraft/core": "^0.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./resources": "./src/resources/index.ts",
    "./prompts": "./src/prompts/index.ts",
    "./*": "./src/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "Model Context Protocol automation server for Downdraft \u2014 exposes engine state, entities, assets, and screenshots as MCP tools for AI-driven testing and inspection."
}
