{
  "name": "@downdraft/library-models",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./codecs": "./src/codecs/index.ts",
    "./fbx": "./src/fbx/index.ts",
    "./*": "./src/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "dependencies": {
    "@downdraft/core": "^0.1.0",
    "@h00w/basis-universal-transcoder": "^2.1.0",
