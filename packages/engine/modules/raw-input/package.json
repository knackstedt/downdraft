{
  "name": "@downdraft/module-raw-input",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./main-entry": "./src/main-entry.ts",
    "./polyfill": "./src/renderer/polyfill.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "dependencies": {
    "@downdraft/core": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "native",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "Raw input module \u2014 OS-level mouse/keyboard capture for raw-delta input paths (e.g. pointer-lock-free FPS input)."
}
