{
  "name": "@downdraft/module-electron-osr",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./main-entry": "./src/main-entry.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./*.wgsl": "./src/*.wgsl",
    "./*.ts": "./src/*.ts"
  },
  "dependencies": {
    "@downdraft/core": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "Electron off-screen rendering module \u2014 OSR surfaces, shared-texture transfer, and paint routing for embedded/headless rendering."
}
