{
  "name": "@downdraft/module-devtools",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@downdraft/app": "^0.1.0",
    "@downdraft/core": "^0.1.0",
    "@downdraft/library-models": "^0.1.0",
    "@downdraft/library-pixi-ui": "^0.1.0",
    "zustand": "^5.0.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./*.wgsl": "./src/*.wgsl",
    "./*.ts": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "extension",
    "README.md",
    "!**/*.spec.ts"
  ],
  "description": "In-engine devtools module \u2014 scene inspector, profiling hooks, and the `downdraft doctor` diagnostics panel."
}
