{
  "name": "@downdraft/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "draft": "src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@downdraft/app": "^0.1.0",
    "@downdraft/core": "^0.1.0",
    "eta": "^3.5.0",
    "jimp": "^1.6.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ],
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "scripts",
    "templates",
    "README.md",
    "!**/*.spec.ts"
  ]
}
