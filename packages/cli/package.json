{
  "name": "@downdraft/cli",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/knackstedt/downdraft.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "draft": "src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@downdraft/engine": "^0.2.0",
    "eta": "^3.5.0",
    "jimp": "^1.6.1",
    "resedit": "3.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "scripts",
    "templates",
    "README.md",
    "!**/*.spec.ts",
    "!**/*.test.ts"
  ],
  "description": "The `draft` command-line tool — project scaffolding (draft new), dev server, builds, release packaging, mobile targets, and plugin/module scaffolding."
}
