// Per-game electron-builder config with branded Windows version-info
// and PE compilation-timestamp patching.
//
// `draft release` (and the deprecated `draft dist`) loads this file instead
// of the inline `build` block in package.json. The factory fills Windows
// package.json. The factory fills Windows VS_VERSIONINFO fields
// (ProductName, FileDescription, LegalCopyright, CompanyName, FileVersion)
// from the metadata below and patches the PE TimeDateStamp of every
// produced .exe so VirusTotal reports the actual build date.
import { createDowndraftBuilderConfig } from "@downdraft/engine/app/build";

export default createDowndraftBuilderConfig({
  appId: "com.<%= it.name %>.game",
  productName: "<%= titleCase(it.name) %>",
  version: "<%= it.version %>",<% if (it.description) { %>
  description: "<%= it.description %>",<% } %><% if (it.author) { %>
  author: "<%= it.author %>",<% } %>
});
