import {
  c,
  Component,
  createLogger,
  createSimWorker,
  Query,
  q,
  spawn,
  Stage,
  systemWithParams,
  World,
} from "@downdraft/core";

const log = createLogger();

// Full template sim worker — an ECS World with a rotation system.
// createSimWorker owns the tick loop, worker protocol, and stats;
// this file provides onInit + onTick.

// --- Components ---

type TransformData = {
  position: [number, number, number];
  rotation: [number, number, number];
  scale: number;
};

const Transform = Component.register<TransformData>("Transform", {
  position: [0, 0, 0],
  rotation: [0, 0, 0],
  scale: 1,
});

type RenderableData = {
  mesh: string;
  color: [number, number, number];
};

const Renderable = Component.register<RenderableData>("Renderable", {
  mesh: "cube",
  color: [1, 1, 1],
});

// --- Queries ---

const rotateQuery = new Query([Transform.id, Renderable.id]);

let world: World;

createSimWorker({
  fixedDt: 1 / 60,

  onInit() {
    world = new World();

    // Spawn ground entity
    spawn(world,
      c(Transform, { position: [0, -0.5, 0], scale: 10 }),
      c(Renderable, { mesh: "cube", color: [0.3, 0.5, 0.3] }),
    );

    // Spawn rotating entities
    for (let i = 0; i < 5; i++) {
      spawn(world,
        c(Transform, { position: [(i - 2) * 2, 0.5, 0] }),
        c(Renderable, {
          mesh: i % 2 === 0 ? "cube" : "sphere",
          color: [Math.random(), Math.random(), Math.random()],
        }),
      );
    }

    // Register system using systemWithParams for typed dependency injection
    const rotateSystem = systemWithParams(
      "rotate-entities",
      Stage.Update,
      [q(Transform, Renderable)],
      (ctx, entities) => {
        entities.iterate(ctx.tick, (_entity, comps) => {
          const transform = comps[0] as TransformData;
          const [rx, ry, rz] = transform.rotation;
          transform.rotation = [rx, ry + ctx.dt * 0.5, rz];
        });
      },
    );

    world.schedule.addSystem(rotateSystem);

    log.info("sim", "full demo initialized — 5 entities on a ground plane");
  },

  onTick(dt) {
    world.step(dt);
  },

  onShutdown() {
    log.info("sim", "sim worker shutdown");
  },
});
