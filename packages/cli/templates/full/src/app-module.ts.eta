import { AppRenderer } from "@downdraft/engine";
import type { AppModule } from "@downdraft/engine/app/main";
import { SimHost } from "./sim-host";

// ============================================================================
// Full template — ECS sim worker + AppRenderer + engine libraries
//
// The sim runs in sim-worker.ts (a Web Worker): an ECS World with a rotation
// system. The SAME module drives both entry points:
//   src/native-entry.ts — Bun + SDL + wgpu-native (draft dev, the default)
// Engine libraries can be declared via AppModule.libraries[] for automatic
// SAB allocation + DI wiring.
// ============================================================================

export const appModule: AppModule = {
  // ── Renderer + Sim ──
  renderer: (canvas) => new AppRenderer(canvas),
  sim: () => new SimHost(),
  simConfig: { seed: 12345 },

  // ── Post-init wiring ──
  onReady: (ctx) => {
    console.log("[app] ready", { simSAB: ctx.simSAB, inputSAB: ctx.inputSAB });
  },

  // ── Cleanup ──
  onDispose: () => {
    console.log("[app] disposed");
  },
};
