import {
  Camera,
  Component,
  createLogger,
  MeshBuilder,
  Query,
  Stage,
  systemWithParams,
  q,
  resourceToken,
  World,
} from "@downdraft/core";

const log = createLogger();

// --- Components ---

interface TransformData {
  position: [number, number, number];
  rotation: [number, number, number];
  scale: number;
}

const Transform = Component.register<TransformData>("Transform", {
  position: [0, 0, 0],
  rotation: [0, 0, 0],
  scale: 1,
});

interface RenderableData {
  mesh: string;
  color: [number, number, number];
}

const Renderable = Component.register<RenderableData>("Renderable", {
  mesh: "cube",
  color: [1, 1, 1],
});

// --- Typed resource tokens ---

const CameraResource = resourceToken<Camera>("camera");

// --- Queries ---

const rotateQuery = new Query([Transform.id, Renderable.id]);

let world: World;

export function init(ctx: any) {
  world = new World();

  const camera = new Camera();
  camera.setAspect(16, 9);
  camera.distance = 10;
  camera.orbit(0, 0.4);
  world.setResourceTyped(CameraResource, camera);

  const cubeMesh = MeshBuilder.cube(1);
  world.setResource("cubeMesh", cubeMesh);

  const sphereMesh = MeshBuilder.sphere(0.5, 16, 16);
  world.setResource("sphereMesh", sphereMesh);

  // Spawn ground entity — world.spawn requires a Map<ComponentId, unknown>
  world.spawn(new Map([
    [Transform.id, Transform.create({
      position: [0, -0.5, 0],
      scale: 10,
    })],
    [Renderable.id, Renderable.create({
      mesh: "cube",
      color: [0.3, 0.5, 0.3],
    })],
  ]));

  // Spawn rotating entities
  for (let i = 0; i < 5; i++) {
    world.spawn(new Map([
      [Transform.id, Transform.create({
        position: [(i - 2) * 2, 0.5, 0],
      })],
      [Renderable.id, Renderable.create({
        mesh: i % 2 === 0 ? "cube" : "sphere",
        color: [Math.random(), Math.random(), Math.random()],
      })],
    ]));
  }

  // Register system using systemWithParams for typed dependency injection
  const rotateSystem = systemWithParams(
    "rotate-entities",
    Stage.Update,
    [q(Transform, Renderable)],
    (ctx, entities) => {
      entities.iterate(ctx.tick, (_entity, comps) => {
        const transform = comps[0] as TransformData;
        const [rx, ry, rz] = transform.rotation;
        transform.rotation = [rx, ry + ctx.dt * 0.5, rz];
      });
    },
  );

  world.schedule.addSystem(rotateSystem);

  log.info("full demo initialized — 5 entities on a ground plane");
}

export function tick(ctx: any, dt: number) {
  world.step(dt);
}

export function dispose(ctx: any) {
  log.info("disposed");
}
