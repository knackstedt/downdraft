import {
  Camera,
  Component,
  createLogger,
  MeshBuilder,
  system,
  World,
} from "@downdraft/core";

const log = createLogger();

interface TransformData {
  [key: string]: unknown;
  position: [number, number, number];
  rotation: [number, number, number];
  scale: number;
}

const Transform = Component.register<TransformData>("Transform", {
  position: [0, 0, 0],
  rotation: [0, 0, 0],
  scale: 1,
});

interface RenderableData {
  [key: string]: unknown;
  mesh: string;
  color: [number, number, number];
}

const Renderable = Component.register<RenderableData>("Renderable", {
  mesh: "cube",
  color: [1, 1, 1],
});

let world: World;
let camera: Camera;
let frameCount = 0;

export function init(ctx: any) {
  world = new World();
  camera = new Camera();
  camera.setAspect(16, 9);
  camera.distance = 10;
  camera.orbit(0, 0.4);
  world.setResource("camera", camera);

  const cubeMesh = MeshBuilder.cube(1);
  world.setResource("cubeMesh", cubeMesh);

  const sphereMesh = MeshBuilder.sphere(0.5, 16, 16);
  world.setResource("sphereMesh", sphereMesh);

  const ground = world.spawn();
  world.addComponent(ground, Transform.create({
    position: [0, -0.5, 0],
    rotation: [0, 0, 0],
    scale: 10,
  }));
  world.addComponent(ground, Renderable.create({
    mesh: "cube",
    color: [0.3, 0.5, 0.3],
  }));

  for (let i = 0; i < 5; i++) {
    const ent = world.spawn();
    world.addComponent(ent, Transform.create({
      position: [(i - 2) * 2, 0.5, 0],
      rotation: [0, 0, 0],
      scale: 1,
    }));
    world.addComponent(ent, Renderable.create({
      mesh: i % 2 === 0 ? "cube" : "sphere",
      color: [Math.random(), Math.random(), Math.random()],
    }));
  }

  log.info("full demo initialized — 5 entities on a ground plane");
}

export function tick(ctx: any, dt: number) {
  frameCount++;

  system("rotate-entities", (w: World, _dt: number) => {
    const view = w.view([Transform, Renderable]);
    for (let i = 0; i < view.length; i++) {
      const ent = view[i];
      const transform = w.getComponent(ent, Transform);
      if (transform) {
        const [rx, ry, rz] = transform.data.rotation as [number, number, number];
        transform.data.rotation = [rx, ry + _dt * 0.5, rz];
      }
    }
  })(world, dt);
}

export function dispose(ctx: any) {
  log.info("disposed");
}
