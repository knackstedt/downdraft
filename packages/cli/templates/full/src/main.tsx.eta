import { GameRenderer } from "@downdraft/core";
import { startGame } from "@downdraft/app/renderer";
import { SimHost } from "./sim-host";

// ============================================================================
// Full template — ECS sim worker + GameRenderer + engine libraries
//
// The sim runs in sim-worker.ts (a Web Worker): an ECS World with a rotation
// system. This entry wires it to startGame() and mounts the UI overlay.
// Engine libraries can be declared via GameModule.libraries[] for automatic
// SAB allocation + DI wiring.
// ============================================================================

startGame({
  // ── Renderer + Sim ──
  renderer: (canvas) => new GameRenderer(canvas),
  sim: () => new SimHost(),
  simConfig: { seed: 12345 },

  // ── UI ──
  mountUI: (overlay) => {
    overlay.innerHTML =
      '<h1 style="color:white;font-family:monospace">Downdraft game</h1>';
  },

  // ── Post-init wiring ──
  onReady: (ctx) => {
    console.log("[game] ready", { simSAB: ctx.simSAB, inputSAB: ctx.inputSAB });
  },

  // ── Cleanup ──
  onDispose: () => {
    console.log("[game] disposed");
  },
}).catch((e) => {
  console.error("[game] Fatal:", e);
});
