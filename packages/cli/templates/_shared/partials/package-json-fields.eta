  "version": "<%= it.version %>",<% if (it.description) { %>
  "description": "<%= it.description %>",<% } %><% if (it.author) { %>
  "author": { "name": "<%= it.author %>" },<% } %>
  "type": "module",
  "scripts": {
    "dev": "draft dev",
    "build": "draft release --stage=build",
    "dist": "draft release",
    "export": "draft release --stage=package --format=launcher",
    "mobile": "draft release --target=android,ios",
    "release": "draft release",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "npm test",
    "postinstall": "node node_modules/electron/install.js"
  },
