{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev",
      "detail": "Start the game in dev mode with hot reload",
      "type": "shell",
      "command": "draft dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Release",
      "detail": "Build + package for a target platform (desktop + mobile)",
      "type": "shell",
      "command": "draft release --target=${input:releaseTarget} --mode=${input:buildMode}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Build Only",
      "detail": "Bundle the game with Vite (no packaging)",
      "type": "shell",
      "command": "draft release --stage=build --mode=${input:buildMode}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Typecheck",
      "detail": "Run tsc --noEmit",
      "type": "shell",
      "command": "npm run typecheck",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Lint",
      "detail": "Run oxlint",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test",
      "detail": "Run tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "releaseTarget",
      "type": "pickString",
      "options": ["all", "win", "linux", "mac", "android", "ios"],
      "default": "all",
      "description": "Target platform(s)"
    },
    {
      "id": "buildMode",
      "type": "pickString",
      "options": ["prod", "dev", "debug"],
      "default": "prod",
      "description": "Build mode"
    }
  ]
}
