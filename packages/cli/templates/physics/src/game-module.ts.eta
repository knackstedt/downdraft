import { GameRenderer } from "@downdraft/engine";
import type { GameModule } from "@downdraft/engine/app/renderer";
import { SimHost } from "./sim-host";

// ============================================================================
// Physics template — ECS sim worker + GameRenderer
//
// The sim runs in sim-worker.ts (a Web Worker): an ECS World with gravity and
// integration systems that spawns falling shapes. The SAME module drives
// both entry points:
//   src/main.tsx        — browser/Electron (draft dev --electron)
//   src/native-entry.ts — Bun + SDL + wgpu-native (draft dev, the default)
// ============================================================================

export const gameModule: GameModule = {
  // ── Renderer + Sim ──
  renderer: (canvas) => new GameRenderer(canvas),
  sim: () => new SimHost(),
  simConfig: { seed: 12345 },

  // ── UI ──
  mountUI: (overlay) => {
    overlay.innerHTML =
      '<h1 style="color:white;font-family:monospace">Physics demo</h1>';
  },

  // ── Post-init wiring ──
  onReady: (ctx) => {
    console.log("[game] ready", { simSAB: ctx.simSAB, inputSAB: ctx.inputSAB });
  },

  // ── Cleanup ──
  onDispose: () => {
    console.log("[game] disposed");
  },
};
