import {
    Camera,
    Collider,
    Component,
    createBoxCollider,
    createLogger,
    createSphereCollider,
    MeshBuilder,
    PhysicsTransform,
    Query,
    RigidBody,
    Stage,
    system,
    Velocity,
    World
} from "@downdraft/core";

const log = createLogger();

interface PhysicsBodyData {
  bodyType: "dynamic" | "static" | "kinematic";
  mass: number;
  restitution: number;
  friction: number;
}

const PhysicsBody = Component.register<PhysicsBodyData>("PhysicsBody", {
  bodyType: "dynamic",
  mass: 1,
  restitution: 0.4,
  friction: 0.5,
});

interface FallingShapeData {
  shape: "box" | "sphere";
  size: number;
  color: [number, number, number];
}

const FallingShape = Component.register<FallingShapeData>("FallingShape", {
  shape: "box",
  size: 1,
  color: [1, 1, 1],
});

const gravityQuery = new Query([RigidBody.id, Velocity.id, PhysicsTransform.id]);

let world: World;
let camera: Camera;
let spawnTimer = 0;

export function init(ctx: any) {
  world = new World();
  camera = new Camera();
  camera.setAspect(16, 9);
  camera.distance = 20;
  camera.orbit(0, 0.5);
  world.setResource("camera", camera);

  const groundMesh = MeshBuilder.cube(20);
  world.setResource("groundMesh", groundMesh);

  const cubeMesh = MeshBuilder.cube(1);
  world.setResource("cubeMesh", cubeMesh);

  const sphereMesh = MeshBuilder.sphere(0.5, 16, 16);
  world.setResource("sphereMesh", sphereMesh);

  // Spawn ground entity — world.spawn requires a Map<ComponentId, unknown>
  world.spawn(new Map([
    [PhysicsBody.id, PhysicsBody.create({
      bodyType: "static",
      mass: 0,
      restitution: 0.3,
      friction: 0.8,
    })],
    [Collider.id, Collider.create(createBoxCollider(20, 1, 20))],
    [PhysicsTransform.id, PhysicsTransform.create({
      position: [0, -1, 0],
    })],
    [FallingShape.id, FallingShape.create({
      shape: "box",
      size: 20,
      color: [0.3, 0.5, 0.3],
    })],
  ]));

  // Register physics systems
  world.schedule.addSystem(system(
    "physics-gravity", Stage.Update,
    (ctx) => {
      gravityQuery.iterate(ctx.tick, (_ent, comps) => {
        const body = comps[0] as any;
        const vel = comps[1] as any;
        if (body && vel && body.bodyType === "dynamic") {
          vel.linear[1] -= 9.81 * ctx.dt * (body.gravityScale as number);
        }
      });
    },
    { queries: [gravityQuery] },
  ));

  world.schedule.addSystem(system(
    "physics-integrate", Stage.Update,
    (ctx) => {
      gravityQuery.iterate(ctx.tick, (ent, comps) => {
        const body = comps[0] as any;
        const vel = comps[1] as any;
        const transform = comps[2] as any;
        if (body && vel && transform && body.bodyType === "dynamic") {
          const [vx, vy, vz] = vel.linear as [number, number, number];
          const [px, py, pz] = transform.position as [number, number, number];
          const newPy = py + vy * ctx.dt;
          transform.position = [px + vx * ctx.dt, newPy, pz + vz * ctx.dt];

          if (newPy < -10) {
            world.despawn(ent);
          }
        }
      });
    },
    { queries: [gravityQuery] },
  ));

  log.info("physics demo initialized — shapes will fall and bounce on the ground");
}

export function tick(ctx: any, dt: number) {
  spawnTimer += dt;
  if (spawnTimer > 0.5) {
    spawnTimer = 0;
    spawnFallingShape();
  }

  world.step(dt);
}

function spawnFallingShape(): void {
  const isBox = Math.random() > 0.5;
  const size = 0.5 + Math.random() * 1.5;
  const x = (Math.random() - 0.5) * 10;
  const z = (Math.random() - 0.5) * 10;

  const components = new Map<number, unknown>([
    [PhysicsBody.id, PhysicsBody.create({
      bodyType: "dynamic",
      mass: size * size * size,
      restitution: 0.3 + Math.random() * 0.4,
      friction: 0.3 + Math.random() * 0.4,
    })],
    [RigidBody.id, RigidBody.create({
      bodyType: "dynamic",
      mass: size * size * size,
      gravityScale: 1,
    })],
    [Velocity.id, Velocity.create({
      linear: [(Math.random() - 0.5) * 2, 0, (Math.random() - 0.5) * 2],
      angular: [0, 0, 0],
    })],
    [PhysicsTransform.id, PhysicsTransform.create({
      position: [x, 15, z],
    })],
  ]);

  if (isBox) {
    components.set(Collider.id, Collider.create(createBoxCollider(size, size, size)));
    components.set(FallingShape.id, FallingShape.create({
      shape: "box",
      size,
      color: [Math.random(), Math.random(), Math.random()],
    }));
  } else {
    components.set(Collider.id, Collider.create(createSphereCollider(size * 0.5)));
    components.set(FallingShape.id, FallingShape.create({
      shape: "sphere",
      size: size * 0.5,
      color: [Math.random(), Math.random(), Math.random()],
    }));
  }

  world.spawn(components);
}

export function dispose(ctx: any) {
  log.info("disposed");
}
