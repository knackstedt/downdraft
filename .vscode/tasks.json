    },
    {
      "label": "Build: Game(s)",
      "detail": "Pick game(s) + target platform(s), then build + package each (native compile via draft release)",
      "type": "shell",
      "command": "bun run packages/cli/src/index.ts build-games --games=\"${input:game}\" --platforms=\"${input:platforms}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "filePattern": "games/**"
    }
  ],
  "inputs": [
    {
      "id": "platforms",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "command": "printf '%s\\n' 'win|Windows|Standalone .exe + runtime tree' 'linux|Linux|Standalone binary + runtime tree' 'mac|macOS|Standalone binary + runtime tree' 'all|All desktop|win + linux + mac'",
        "fieldSeparator": "|",
        "multiselect": true,
        "multiselectSeparator": ",",
        "description": "Select target platform(s) \u2014 pick multiple to build several at once"
      }
    },
    {
      "id": "game",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "command": "node -e \"const fs=require('fs');for(const d of fs.readdirSync('games')){const c='games/'+d+'/src/native-entry.ts',j='games/'+d+'/package.json';if(!fs.existsSync(c))continue;let pn=d;try{pn=JSON.parse(fs.readFileSync(j,'utf8')).productName||d}catch{};console.log(d+'|'+pn+'|Build '+pn)}\"",
        "cwd": "${workspaceFolder}",
        "fieldSeparator": "|",
        "multiselect": true,
        "multiselectSeparator": ",",
        "description": "Select game(s) to build \u2014 pick multiple to build several at once"
      }
    }
  ]
}
