{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cargo Build",
      "type": "shell",
      "command": "echo 'Run Build Audio Native and Build Physics Native'",
      "dependsOn": ["Build Audio Native", "Build Physics Native"],
      "problemMatcher": []
    },
    {
      "label": "Dev",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: To The Ocean",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOWNDRAFT_GAME": "to-the-ocean"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "bun run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
