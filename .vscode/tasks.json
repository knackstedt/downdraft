      },
      "isBackground": true,
      "problemMatcher": [],
      "filePattern": "apps/archery-app/**"
    },
    {
      "label": "Build: App(s)",
      "detail": "Pick app(s) + target platform(s), then build + package each (native compile via draft release)",
      "type": "shell",
      "command": "bun run packages/cli/src/index.ts release --apps=\"${input:app}\" --target=\"${input:platforms}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "filePattern": "apps/**"
    }
  ],
  "inputs": [
    {
      "id": "platforms",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "command": "printf '%s\\n' 'win|Windows|Standalone .exe + runtime tree' 'linux|Linux|Standalone binary + runtime tree' 'mac|macOS|Standalone binary + runtime tree' 'all|All desktop|win + linux + mac'",
        "fieldSeparator": "|",
        "multiselect": true,
        "multiselectSeparator": ",",
        "description": "Select target platform(s) \u2014 pick multiple to build several at once"
      }
    },
    {
      "id": "app",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "command": "node -e \"const fs=require('fs');for(const d of fs.readdirSync('apps')){const c='apps/'+d+'/src/native-entry.ts',j='apps/'+d+'/package.json';if(!fs.existsSync(c))continue;let pn=d;try{pn=JSON.parse(fs.readFileSync(j,'utf8')).productName||d}catch{};console.log(d+'|'+pn+'|Build '+pn)}\"",
        "cwd": "${workspaceFolder}",
        "fieldSeparator": "|",
        "multiselect": true,
        "multiselectSeparator": ",",
        "description": "Select app(s) to build \u2014 pick multiple to build several at once"
      }
    }
  ]
}
