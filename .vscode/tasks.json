{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Audio Native",
      "type": "shell",
      "command": "./build.sh",
      "options": {
        "cwd": "${workspaceFolder}/packages/audio-native"
      },
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "Build Physics Native",
      "type": "shell",
      "command": "./build.sh",
      "options": {
        "cwd": "${workspaceFolder}/packages/physics-native"
      },
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "Build All Native",
      "type": "shell",
      "command": "echo 'Run Build Audio Native and Build Physics Native'",
      "dependsOn": ["Build Audio Native", "Build Physics Native"],
      "problemMatcher": []
    },
    {
      "label": "Dev",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "bun run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "bun run tsc",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "bun run lint",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
