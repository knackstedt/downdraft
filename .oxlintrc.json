{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc-assets/main/schema.json",
  "jsPlugins": [
    {
      "name": "downdraft",
      "specifier": "@downdraft/engine/lint-plugin"
    }
  ],
  "rules": {
    "no-console": [
      "error",
      {
        "allow": [
          "trace"
        ]
      }
    ],
    "no-unused-vars": "warn",
    "no-debugger": "error",
    "no-empty": "warn",
    "no-unreachable": "error",
    "no-irregular-whitespace": "error",
    "no-loss-of-precision": "error",
    "no-prototype-builtins": "warn",
    "no-sparse-arrays": "warn",
    "no-unsafe-finally": "error",
    "no-unsafe-optional-chaining": "error",
    "no-useless-catch": "warn",
    "eqeqeq": "warn",
    "default-case-last": "warn",
    "downdraft/no-for-of": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/cli/**",
        "tests/**",
        "**/test/**",
        "**/bench/**",
        "**/test-*.ts",
        "**/*.mjs",
        "scripts/**",
        "packages/*/scripts/**",
        "docs/**",
        "packages/engine/modules/devtools/extension/**",
        "packages/engine/core/src/util/logger.ts",
        "packages/engine/app/src/main/**",
        "packages/engine/app/src/preload/**",
        "packages/engine/core/src/ipc.ts",
        "packages/engine/modules/electron-osr/**",
        "packages/engine/modules/raw-input/**",
        "packages/mobile-shell/**",
        "games/*/src/main.ts",
        "games/*/src/preload.ts",
        "games/*/electron.vite.config.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "rules": {
        "no-console": "off",
        "no-unused-vars": "off"
      }
    }
  ]
}
