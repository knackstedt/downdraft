{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "types": ["@webgpu/types", "node", "bun"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@downdraft/core/*": ["packages/core/src/*"],
      "@downdraft/ui/*": ["packages/ui/src/*"],
      "@downdraft/mcp/*": ["packages/mcp/src/*"],
      "@downdraft/shader-graph/*": ["packages/shader-graph/src/*"],
      "@downdraft/cli/*": ["packages/cli/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
