{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@downdraft/core/*": ["packages/core/src/*"],
      "@downdraft/core": ["packages/core/src/index.ts"],
      "@downdraft/ui/*": ["packages/ui/src/*"],
      "@downdraft/mcp/*": ["packages/mcp/src/*"],
      "@downdraft/shader-graph/*": ["packages/shader-graph/src/*"],
      "@downdraft/cli/*": ["packages/cli/src/*"],
      "@downdraft/plugin-water": ["packages/plugins/water/src/index.ts"],
      "@downdraft/plugin-water/*": ["packages/plugins/water/src/*"],
      "@downdraft/plugin-physics-rapier": ["packages/plugins/physics-rapier/src/index.ts"],
      "@downdraft/plugin-audio-kira": ["packages/plugins/audio-kira/src/index.ts"]
    }
  },
  "references": [
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.web.json" }
  ]
}
