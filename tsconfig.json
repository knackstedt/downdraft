{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "xxh3-ts": [
        "./packages/engine/libraries/persistence/src/xxh3-ts.d.ts"
      ],
      "@shared/*": [
        "./packages/engine/app/src/shared/*"
      ]
    }
  },
  "exclude": [
    "dist",
    "release",
    "node_modules"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.web.json"
    }
  ]
}
