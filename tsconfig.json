{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "xxh3-ts": [
        "./packages/plugins/persistence/src/xxh3-ts.d.ts"
      ],
      "@shared/*": [
        "./games/to-the-ocean/src/shared/*",
        "./packages/app/src/shared/*"
      ],
      "@main/*": [
        "./packages/app/src/main/*"
      ],
      "@sim/*": [
        "./games/to-the-ocean/src/simulation/*"
      ],
      "@downdraft/core/*": [
        "./packages/core/src/*"
      ],
      "@downdraft/core": [
        "./packages/core/src/index.ts"
      ],
      "@downdraft/ui/*": [
        "./packages/ui/src/*"
      ],
      "@downdraft/mcp/*": [
        "./packages/mcp/src/*"
      ],
      "@downdraft/shader-graph/*": [
        "./packages/shader-graph/src/*"
      ],
      "@downdraft/cli/*": [
        "./packages/cli/src/*"
      ],
      "@downdraft/plugin-water": [
        "./packages/plugins/water/src/index.ts"
      ],
      "@downdraft/plugin-water/*": [
        "./packages/plugins/water/src/*"
      ],
      "undertow": [
        "./packages/plugins/undertow/src/index.ts"
      ],
      "undertow/*": [
        "./packages/plugins/undertow/src/*"
      ],
      "@downdraft/plugin-physics-rapier": [
        "./packages/plugins/physics-rapier/src/index.ts"
      ],
      "@downdraft/plugin-audio-kira": [
        "./packages/plugins/audio-kira/src/index.ts"
      ],
      "@downdraft/library-postfx": [
        "./packages/plugins/postfx/src/index.ts"
      ],
      "@downdraft/library-postfx/*": [
        "./packages/plugins/postfx/src/*"
      ],
      "@downdraft/library-lighting": [
        "./packages/plugins/lighting/src/index.ts"
      ],
      "@downdraft/library-lighting/*": [
        "./packages/plugins/lighting/src/*"
      ],
      "@downdraft/plugin-weatherfx": [
        "./packages/plugins/weatherfx/src/index.ts"
      ],
      "@downdraft/plugin-weatherfx/*": [
        "./packages/plugins/weatherfx/src/*"
      ],
      "@downdraft/library-weather": [
        "./packages/plugins/weather/src/index.ts"
      ],
      "@downdraft/library-weather/*": [
        "./packages/plugins/weather/src/*"
      ],
      "@downdraft/library-entities": [
        "./packages/plugins/entities/src/index.ts"
      ],
      "@downdraft/library-entities/*": [
        "./packages/plugins/entities/src/*"
      ],
      "@downdraft/plugin-models": [
        "./packages/plugins/models/src/index.ts"
      ],
      "@downdraft/plugin-models/*": [
        "./packages/plugins/models/src/*"
      ],
      "@downdraft/plugin-devtools": [
        "./packages/plugins/devtools/src/index.ts"
      ],
      "@downdraft/plugin-devtools/*": [
        "./packages/plugins/devtools/src/*"
      ],
      "@to-the-ocean/util/*": [
        "./games/to-the-ocean/src/util/*"
      ],
      "@sand-native/sand_native": [
        "./games/falling-sand/sand-native/pkg/sand_native.js"
      ],
      "@sand-native/sand_native/*": [
        "./games/falling-sand/sand-native/pkg/*"
      ]
    }
  },
  "exclude": [
    "dist",
    "release",
    "node_modules"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.web.json"
    }
  ]
}
