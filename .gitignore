node_modules
packages/*/node_modules
/build

# Games are separate repos, not part of this repo. Clone them under games/
# (or anywhere) for local dev — see AGENTS.md "Repository layout".
games/

# Local environment files — never commit secrets.
.env
.env.*

# Electron build output
dist
release

# Devin MCP local overrides (personal API keys)
.devin/config.local.json

# TypeScript composite project info files
.tsbuildinfo.*

# Asset cache (downloaded from blob store)
.downdraft-cache

# Asset bake cache (optimized assets produced by the bake step)
.downdraft/bake

# E2E test artifacts (screenshots, logs)
tests/e2e/artifacts/

# PixiJS polyfill visual-parity test artifacts (generated screenshots/diffs)
tests/pixi-polyfill/artifacts/
tests/pixi-polyfill/browser/entry.js

# Native screenshot test output (generated by test-screenshot.ts)
native-screenshot.png

# Native binaries — fetched at install via `bun run fetch:native` in
# packages/platform-native, not committed. Rust cdylibs are built from source
# via `bun run build:native` (root Cargo workspace + scripts/build-native.mjs).
packages/platform-native/native/bin/
packages/platform-native/native/lib/
packages/platform-native/native/*.so
packages/platform-native/native/*.dll
packages/platform-native/native/*.dylib
packages/platform-native/native/*.zip
packages/platform-native/native/*-extract/
packages/platform-native/native/*-download.zip
# Per-platform artifact dirs staged by build-native.mjs / fetch-at-install.
packages/platform-native/native/linux-*/
packages/platform-native/native/darwin-*/
packages/platform-native/native/win32-*/
packages/platform-native/native/android-*/
# npm platform packages — lib/ is populated from artifact bundles at publish.
packages/native-*/lib/
# npm node-mobile packages — lib/ + include/ populated from bundles at publish.
packages/node-mobile-android-*/lib/
packages/node-mobile-android-*/include/
artifacts/

# Root Cargo workspace target dir (crates are members — artifacts land here).
/target/

# Rust devtools native lib — built from packages/engine/libraries/devtools/native via
# build.sh (cargo). The .so copy next to src/ and the cargo target/ dir are
# build artifacts, not source.
packages/engine/libraries/devtools/native/target/
packages/engine/libraries/devtools/native/dist/
packages/engine/libraries/devtools/native/*.so

# Other Rust cdylib crates — same rule: cargo target/ + built .so are artifacts.
packages/engine/libraries/physics-native/native/target/
packages/engine/libraries/audio-kira/native/target/
packages/engine/libraries/blitz-ui/native-osr/target/
# Test-bed Rust crates (e.g. ui-bakeoff's blitz-app wasm) — same rule.
test-beds/**/target/

test-results/
