---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import logoSvg from '../assets/logo.svg';
---

<StarlightPage frontmatter={{ title: 'DownDraft', template: 'splash' }} hasSidebar={false}>
	<div class="landing-root">
		<!-- Background grid -->
		<div class="grid-bg" aria-hidden="true"></div>

		<!-- Vector field -->
		<svg class="vector-field" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 1000 1000">
			<path d="M -50 100 Q 250 250, 200 500 T 350 1050" />
			<path d="M 100 -50 Q 400 150, 320 450 T 500 1050" />
			<path d="M 300 -50 Q 600 200, 500 500 T 650 1050" />
			<path d="M 550 -50 Q 800 180, 700 480 T 820 1050" />
			<path d="M 800 -50 Q 1050 220, 900 520 T 1000 1050" />
			<path d="M -100 350 Q 150 450, 100 700 T 220 1050" />
		</svg>

		<!-- Corner crosshairs -->
		<div class="crosshair tl" aria-hidden="true"></div>
		<div class="crosshair tr" aria-hidden="true"></div>
		<div class="crosshair bl" aria-hidden="true"></div>
		<div class="crosshair br" aria-hidden="true"></div>

		<!-- HERO -->
		<section class="hero">
			<div class="hero-inner">
				<div class="logo-ring">
					<img src={logoSvg.src} alt="DownDraft" width={80} height={80} class="hero-logo" />
				</div>
				<h1 class="headline">
					<span class="line">Native engine.</span>
					<span class="line">WebGPU rendering.</span>
					<span class="line accent">TypeScript-first.</span>
				</h1>
				<p class="subheadline">
					DownDraft is a game engine that runs your TypeScript on a native runtime — winit + wgpu
					under Bun, Node, or Deno. Real desktop windows, not a browser. A typed-DI module system,
					a sandboxed plugin/mod loader, and a built-in MCP server for AI-assisted development.
				</p>
				<div class="cta-row">
					<a href="/getting-started/introduction/" class="btn btn-primary">
						<span>Get Started</span>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
					<a href="https://github.com/knackstedt/downdraft-engine" class="btn btn-secondary" target="_blank" rel="noopener">
						<span>GitHub</span>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
					</a>
				</div>
			</div>
		</section>

		<!-- ONE-LINE INSTALL -->
		<section class="install-section">
			<div class="section-inner">
				<p class="section-eyebrow">Quick Start</p>
				<h2 class="section-title">Scaffold a new game</h2>
				<p class="install-subtitle">Bootstrap a project with the DownDraft CLI — templates, configs, and dev server all set up for you.</p>
				<div class="terminal">
					<div class="terminal-header">
						<div class="terminal-dots">
							<span class="dot red" />
							<span class="dot yellow" />
							<span class="dot green" />
						</div>
						<span class="terminal-title">bash</span>
					</div>
					<div class="terminal-body">
						<code class="terminal-code">bunx @downdraft/cli new my-game</code>
						<button class="copy-btn" aria-label="Copy to clipboard" data-command="bunx @downdraft/cli new my-game">
							<svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
							<svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
						</button>
					</div>
				</div>
				<div class="install-meta">
					<span class="pill">Bun</span>
					<span class="pill">winit</span>
					<span class="pill">WebGPU</span>
					<span class="pill">TypeScript</span>
					<span class="pill">Rapier3D</span>
				</div>
			</div>
		</section>

		<!-- FEATURES -->
		<section class="features-section">
			<div class="section-inner">
				<p class="section-eyebrow">Capabilities</p>
				<h2 class="section-title">The core systems, wired together</h2>
				<div class="feature-grid">
					<article class="feature-card">
						<div class="feature-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
						</div>
						<h3 class="feature-title">ECS Architecture</h3>
						<p class="feature-desc">Entity-component-system that scales from a few dozen to thousands of entities. Change detection, hierarchy, and event batching built in — so you focus on gameplay, not plumbing.</p>
					</article>
					<article class="feature-card">
						<div class="feature-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
						</div>
						<h3 class="feature-title">WebGPU Rendering</h3>
						<p class="feature-desc">Deferred pipeline with shadows, post-processing, and a render graph with automatic resource aliasing. Ships with html-ui — Blitz HTML/CSS rasterized in a worker and composited in-process — plus an offscreen-rendered surface mode for world-space UI.</p>
					</article>
					<article class="feature-card">
						<div class="feature-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
						</div>
						<h3 class="feature-title">Mods & Plugins</h3>
						<p class="feature-desc">User-authored plugins and mods load at runtime from <code>plugins/</code> — worker-js, WASM, QuickJS, and asset-pack formats behind tiered permissions. Engine features compose separately through a typed-DI module system.</p>
					</article>
					<article class="feature-card">
						<div class="feature-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
						</div>
						<h3 class="feature-title">MCP Server</h3>
						<p class="feature-desc">Built-in MCP server exposes scene editing, entity spawning, asset management, and debugging over JSON-RPC — usable by AI assistants or any MCP client.</p>
					</article>
					<article class="feature-card">
						<div class="feature-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
						</div>
						<h3 class="feature-title">Physics</h3>
						<p class="feature-desc">Rapier3D-powered physics with character controllers, collision detection, and multi-realm support. Swap backends without touching gameplay code.</p>
					</article>
					<article class="feature-card">
						<div class="feature-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
						</div>
						<h3 class="feature-title">Audio</h3>
						<p class="feature-desc">Spatial audio powered by Kira (Rust FFI) with a full mixer, effects chain, and 3D listener tracking.</p>
					</article>
				</div>
			</div>
		</section>

		<!-- TECH STACK -->
		<section class="stack-section">
			<div class="section-inner narrow">
				<p class="section-eyebrow">Architecture</p>
				<h2 class="section-title">Designed for performance</h2>
				<p class="section-lead">
					DownDraft pairs a deferred WebGPU render pipeline with a modular plugin
					ecosystem in a single native process — Bun, Node, or Deno for the JS
					runtime, winit for windowing, wgpu for the GPU. Zero-copy SharedArrayBuffer keeps data
					flowing between threads with no serialization overhead.
				</p>
				<p><a href="/architecture/process-model/">See the architecture docs →</a></p>
				<div class="stack-grid">
					<div class="stack-item">
						<div class="stack-dot" />
						<span>Bun/Node/Deno + winit</span>
					</div>
					<div class="stack-item">
						<div class="stack-dot" />
						<span>WebGPU / WGPU</span>
					</div>
					<div class="stack-item">
						<div class="stack-dot" />
						<span>Worker-backed binary saves</span>
					</div>
					<div class="stack-item">
						<div class="stack-dot" />
						<span>Rapier3D physics</span>
					</div>
					<div class="stack-item">
						<div class="stack-dot" />
						<span>Kira audio (Rust FFI)</span>
					</div>
					<div class="stack-item">
						<div class="stack-dot" />
						<span>Blitz html-ui + devtools</span>
					</div>
					<div class="stack-item">
						<div class="stack-dot" />
						<span>MCP (JSON-RPC)</span>
					</div>
				</div>
			</div>
		</section>

		<!-- WHY NATIVE -->
		<section class="native-section">
			<div class="section-inner narrow">
				<p class="section-eyebrow">Runtime</p>
				<h2 class="section-title">Native all the way down</h2>
				<p class="section-lead">
					DownDraft games run as a single process driving a real OS window and the GPU
					directly — Bun by default, with Node and Deno supported. The platform is a
					Rust library your code calls into, not a shell around it.
				</p>
				<div class="native-grid">
					<div class="native-point">
						<div class="native-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
						</div>
						<div>
							<h3>One process, direct calls</h3>
							<p>Windowing, rendering, assets, and the MCP server all live in one process. Talking to the platform is a plain function call — nothing crosses a process boundary, so nothing gets serialized, copied, or awaited on a channel.</p>
						</div>
					</div>
					<div class="native-point">
						<div class="native-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
						</div>
						<div>
							<h3>Threads where they matter</h3>
							<p>The simulation runs in a dedicated worker thread with SharedArrayBuffer, so heavy game logic never blocks rendering. Workers can even share the GPU device and encode command buffers in parallel.</p>
						</div>
					</div>
					<div class="native-point">
						<div class="native-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
						</div>
						<div>
							<h3>A fraction of the footprint</h3>
							<p>Games ship as one small executable plus a Rust library — tens of megabytes, not hundreds — with low baseline memory. What your GPU draws is exactly what your code asked for.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- HOW A FRAME GETS BUILT -->
		<section class="pipeline-section">
			<div class="section-inner narrow">
				<p class="section-eyebrow">Render Pipeline</p>
				<h2 class="section-title">How a frame gets built</h2>
				<p class="section-lead">
					Everything — simulation, rendering, and UI — runs inside one native process.
					The host owns the window and GPU device; workers handle simulation over
					SharedArrayBuffer. Frames go straight to the screen.
				</p>
				<div class="pipeline">
					<div class="pipeline-step">
						<span class="pipeline-tag">01</span>
						<div>
							<h3>Simulation</h3>
							<p>Single-threaded scheduling for the ECS in a dedicated worker thread, with multicore work dispatched over SharedArrayBuffer — no locks, no serialization.</p>
						</div>
					</div>
					<div class="pipeline-step">
						<span class="pipeline-tag">02</span>
						<div>
							<h3>Render graph</h3>
							<p>wgpu drives the scene — compute shaders, explicit resource binding, and a Bevy-style render graph with automatic resource aliasing. Translated to Vulkan, Metal, or D3D12 depending on platform.</p>
						</div>
					</div>
					<div class="pipeline-step">
						<span class="pipeline-tag">03</span>
						<div>
							<h3>UI — flat path</h3>
							<p>html-ui documents (Blitz HTML/CSS) rasterized in a dedicated worker and drawn straight onto the frame for HUDs, menus, panels, and the docked devtools UI.</p>
						</div>
					</div>
					<div class="pipeline-step">
						<span class="pipeline-tag">04</span>
						<div>
							<h3>UI — world-space path</h3>
							<p>Offscreen UI rendered to a GPU texture via the native-osr module, imported into the render graph and drawn as geometry — for panels that need to exist inside the 3D scene.</p>
						</div>
					</div>
					<div class="pipeline-step">
						<span class="pipeline-tag">05</span>
						<div>
							<h3>Composite</h3>
							<p>One frame, one process — simulation, scene, and interface presented together on the native window. Built-in devtools and tracing profile any of it.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- IN ACTIVE DEVELOPMENT -->
		<section class="status-section">
			<div class="section-inner narrow">
				<p class="section-eyebrow">Status</p>
				<h2 class="section-title">Early, and still moving</h2>
				<p class="section-lead">
					DownDraft grew out of the engine work for To The Ocean and is now being built as
					a standalone engine. Architecture decisions are still being made in the open —
					feedback shapes what ships.
				</p>
				<div class="status-stamp">
					<span class="status-dot"></span>
					In active development
				</div>
			</div>
		</section>

		<!-- FOOTER CTA -->
		<section class="footer-cta">
			<div class="section-inner">
				<h2 class="footer-title">Ready to build something great?</h2>
				<p class="footer-lead">Dive into the docs and start building your game.</p>
				<div class="cta-row">
					<a href="/getting-started/introduction/" class="btn btn-primary">
						<span>Get Started</span>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
					<a href="https://github.com/knackstedt/downdraft-engine" class="btn btn-secondary" target="_blank" rel="noopener">
						<span>Star on GitHub</span>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
					</a>
				</div>
			</div>
		</section>
	</div>
</StarlightPage>

<script>
	const copyBtns = document.querySelectorAll('.copy-btn');
	copyBtns.forEach(btn => {
		btn.addEventListener('click', async () => {
			const command = btn.getAttribute('data-command');
			if (!command) return;
			try {
				await navigator.clipboard.writeText(command);
				btn.classList.add('copied');
				setTimeout(() => btn.classList.remove('copied'), 2000);
			} catch (e) {
				console.error('Copy failed', e);
			}
		});
	});

	// Fade-up on scroll via IntersectionObserver
	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('visible');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.1 });

	document.querySelectorAll('.feature-card, .stack-item, .native-point, .pipeline-step, .status-stamp, .section-title, .section-lead').forEach(el => {
		el.classList.add('reveal');
		observer.observe(el);
	});
</script>

<style>
	.landing-root {
		--ember-orange: #ff5e1a;
		--ember-glow: #ff8c42;
		--ember-deep: #7a1f00;
		--ember-dim: #c4a89b;
		--bg-dark: #0a0504;
		--bg-elevated: #140a08;
		--text-primary: #fff5f0;
		--text-secondary: #c4a89b;
		--radius: 16px;
		--radius-sm: 10px;
	}

	/* Background grid */
	.grid-bg {
		position: fixed;
		inset: 0;
		background-image:
			linear-gradient(rgba(255,94,26,0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255,94,26,0.06) 1px, transparent 1px);
		background-size: 48px 48px;
		opacity: 0.5;
		z-index: 0;
		pointer-events: none;
	}

	/* Vector field */
	.vector-field {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		opacity: 0.4;
	}
	.vector-field path {
		fill: none;
		stroke: var(--ember-dim);
		stroke-width: 1;
		stroke-dasharray: 6 10;
		animation: draft-flow 14s linear infinite;
	}
	.vector-field path:nth-child(odd) { animation-duration: 18s; stroke: rgba(255,140,66,0.25); }
	.vector-field path:nth-child(3n) { animation-duration: 22s; }
	@keyframes draft-flow {
		to { stroke-dashoffset: -320; }
	}

	/* Corner crosshairs */
	.crosshair {
		position: fixed;
		width: 22px;
		height: 22px;
		z-index: 2;
		opacity: 0.5;
		pointer-events: none;
	}
	.crosshair::before, .crosshair::after {
		content: "";
		position: absolute;
		background: var(--ember-dim);
	}
	.crosshair::before { width: 100%; height: 1px; top: 50%; }
	.crosshair::after { height: 100%; width: 1px; left: 50%; }
	.crosshair.tl { top: 24px; left: 24px; }
	.crosshair.tr { top: 24px; right: 24px; }
	.crosshair.bl { bottom: 24px; left: 24px; }
	.crosshair.br { bottom: 24px; right: 24px; }

	/* Hero */
	.hero {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 90vh;
		padding: 6rem 1.5rem 4rem;
		text-align: center;
	}
	.hero-inner {
		max-width: 720px;
		animation: fadeUp 1s ease-out both;
	}
	.logo-ring {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 120px;
		height: 120px;
		border-radius: 50%;
		background: linear-gradient(135deg, rgba(255,94,26,0.15), rgba(255,140,66,0.05));
		box-shadow: 0 0 40px rgba(255,94,26,0.2), inset 0 0 20px rgba(255,94,26,0.05);
		margin-bottom: 2rem;
		animation: pulseGlow 4s ease-in-out infinite;
	}
	.hero-logo {
		width: 64px;
		height: 64px;
		filter: drop-shadow(0 0 12px rgba(255,94,26,0.6));
	}
	@keyframes pulseGlow {
		0%, 100% { box-shadow: 0 0 40px rgba(255,94,26,0.2), inset 0 0 20px rgba(255,94,26,0.05); }
		50% { box-shadow: 0 0 60px rgba(255,94,26,0.35), inset 0 0 30px rgba(255,94,26,0.08); }
	}
	.headline {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
